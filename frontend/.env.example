# Craftlane frontend environment variables (Vite)
#
# Vite exposes every VITE_* variable to client-side code and embeds them in
# the build. NEVER put passwords, private API keys, database credentials, JWT
# signing secrets, payment secrets, or other confidential values here.
#
# Copy this file to `.env` and adjust for local development. The `.env` file is
# gitignored and must never be committed.

# Base URL of the Craftlane backend API (FastAPI).
# Used by the API service layer. Example local-development value:
VITE_API_BASE_URL=http://localhost:8000/api
