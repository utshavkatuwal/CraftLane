# Craftlane — Environment Variables
#
# Craftlane is a monorepo-style project with the frontend under ./frontend/
# and the backend under ./backend/.
#
# Frontend environment variables are configured in frontend/.env.example.
# Backend environment variables are configured in backend/.env.example.
#
# Copy the relevant files for local development:
#
#   cp frontend/.env.example frontend/.env
#   cp backend/.env.example backend/.env
#
# Never commit .env files. They are gitignored.
