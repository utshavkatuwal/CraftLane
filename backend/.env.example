# Craftlane backend environment variables
#
# Copy this file to `.env` and adjust for local development.
# The `.env` file is gitignored and must never be committed.

# Server configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://craftlane:craftlane@localhost:5432/craftlane

# JWT signing secret — generate a strong random value in production
# Example: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Frontend API base URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
